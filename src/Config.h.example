#pragma once

#include <Arduino.h>

// Copy this file to src/Config.h and fill in your station details.
// src/Config.h is gitignored so your credentials stay out of the repository.

// WiFi Configuration
// TODO: Move to WiFiManager or Web Interface
#define WIFI_SSID "YOUR_SSID"
#define WIFI_PASS "YOUR_PASSWORD"

// Beacon Configuration
#define CALLSIGN "N0CALL"
#define GRID_LOCATOR "AA00aa"
#define TX_POWER_DBM                                                           \
  10 // Not actually used for hardware control yet, just for WSPR encoding

// Frequency Configuration
#define WSPR_FREQ_20M 14095600ULL
#define FT8_FREQ_20M 14074000ULL
#define FT8_OFFSET_HZ 1354 // Audio offset within the FT8 passband
#define WSPR_FREQ_40M 7038600ULL

// Crystal error correction, in parts per million.
// Measure the actual carrier with an SDR and adjust:
//   measured 14095750 Hz vs requested 14095600 Hz -> +150 Hz error
//   -> FREQ_CORRECTION_PPM = -150.0 / 14.0956 = -10.6
#define FREQ_CORRECTION_PPM 0.0

// Mode Switches
#define ENABLE_WSPR true
#define ENABLE_FT8 true
#define ENABLE_CW true

// Hardware Configuration
#define RF_PIN 27 // Safe pin, avoiding Boot (0) or TX/RX (1/3)
#define I2C_SDA 21
#define I2C_SCL 22
#define OLED_RESET -1
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

// NTP Configuration
#define NTP_SERVER "pool.ntp.org"
#define UTC_OFFSET 0
